# Copy to .env and fill in.

DATABASE_URL=postgresql+asyncpg://notify:notify@localhost:5440/notify_queue

# Upstash: copy the "rediss://" URL from the Upstash console (Connect > redis-cli / TCP).
# Use rediss:// (TLS). Upstash rejects plain redis:// connections.
REDIS_URL=rediss://default:<password>@<your-endpoint>.upstash.io:6379
# Local alternative: REDIS_URL=redis://localhost:6390/0
REDIS_KEY_PREFIX=nq:
CACHE_ENABLED=true

# Worker / delivery behaviour
FAILURE_RATE=0.1
MAX_ATTEMPTS=5
RATE_LIMIT_PER_HOUR=10
LEASE_SECONDS=30
